<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.dstyle.HomeFragment"
        android:label="Home">
        <action
            android:id="@+id/action_home_to_produtos"
            app:destination="@id/produtosFragment">
            <argument
                android:name="produtoId"
                app:argType="string"/>
        </action>
    </fragment>

    <fragment
        android:id="@+id/produtosFragment"
        android:name="com.example.dstyle.ProdutosFragment"
        android:label="Produtos">
        <argument
            android:name="produtoId"
            app:argType="string"/>
    </fragment>

    <fragment
        android:id="@+id/perfilFragment"
        android:name="com.example.dstyle.PerfilFragment"
        android:label="Perfil"/>
</navigation>
